// 고객·프로젝트·사이트 1차 검수용 DBML
// 비밀값 원문(password/token/private key)은 저장하지 않는다.

Table customers {
  id bigint [pk]
  name varchar(200) [not null]
  status varchar(30) [not null]
  memo text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table customer_contacts {
  id bigint [pk]
  customer_id bigint [not null]
  type varchar(30) [not null]
  name varchar(100)
  value varchar(320) [not null]
  is_primary boolean [not null, default: false]
}

Table categories {
  id bigint [pk]
  parent_id bigint
  name varchar(100) [not null]
  code varchar(50) [unique]
}

Table members {
  id bigint [pk]
  name varchar(100) [not null]
  status varchar(30) [not null]
}

Table projects {
  id bigint [pk]
  customer_id bigint [not null]
  category_id bigint
  title varchar(250) [not null]
  status varchar(30) [not null]
  memo text
}

Table sites {
  id bigint [pk]
  project_id bigint [not null]
  primary_receiver_id bigint
  type varchar(50) [not null]
  status varchar(30) [not null]
  inspection_memo text
}

Table providers {
  id bigint [pk]
  provider_type varchar(30) [not null]
  name varchar(200) [not null]
  website varchar(2048)
}

Table site_endpoints {
  id bigint [pk]
  site_id bigint [not null]
  provider_id bigint
  endpoint_role varchar(30) [not null]
  url varchar(2048) [not null]
  is_primary boolean [not null, default: false]
}

Table site_access_accounts {
  id bigint [pk]
  site_id bigint [not null]
  protocol varchar(20) [not null]
  auth_method varchar(20) [not null]
  login_id varchar(255)
  secret_ref varchar(255) [not null]
  status varchar(30) [not null]
}

Table site_notes {
  id bigint [pk]
  site_id bigint [not null]
  note_type varchar(30) [not null]
  content text [not null]
}

Ref: customer_contacts.customer_id > customers.id
Ref: categories.parent_id > categories.id
Ref: projects.customer_id > customers.id
Ref: projects.category_id > categories.id
Ref: sites.project_id > projects.id
Ref: sites.primary_receiver_id > members.id
Ref: site_endpoints.site_id > sites.id
Ref: site_endpoints.provider_id > providers.id
Ref: site_access_accounts.site_id > sites.id
Ref: site_notes.site_id > sites.id
